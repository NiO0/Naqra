---
import Marquee from "../ui/Marquee.astro";
import { valueStrip } from "../../data/home";
---
<section class="vstrip" aria-label="قيم نقرة">
  <div class="band band--coral" aria-hidden="true">
    <Marquee items={valueStrip} separator="•" speed={0.8} reverse />
  </div>
  <div class="band band--ink">
    <Marquee items={valueStrip} separator="•" speed={1} />
  </div>
</section>

<style>
  /* Two crossing tapes: coral behind (-1.8°), charcoal in front (+2.2°) */
  .vstrip {
    position: relative; z-index: 4;
    padding-block: clamp(1.5rem, 3vw, 3.5rem) clamp(1.5rem, 4.4vw, 5.25rem); /* 250 tall at 1920 */
    margin-top: clamp(-3rem, -1.5vw, -1rem);
    overflow: clip;
  }
  .band {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(1.25rem, 1.875vw, 2.25rem); line-height: 1.45; /* 36 */
    padding-block: 0.875rem;
    width: 110%; margin-inline-start: -5%;
    color: #fff;
  }
  .band :global(.marquee-sep) { font-weight: 600; margin-inline: 0.72em; opacity: 1; }
  .band--coral { background: var(--coral); rotate: -1.8deg; }
  .band--ink {
    position: relative; z-index: 2;
    margin-top: clamp(-4rem, -2.6vw, -1.5rem);
    background: var(--ink); rotate: 2.2deg;
    box-shadow: 0 18px 40px -20px rgb(0 0 0 / 0.35);
  }
  .band--ink :global(.marquee-sep) { color: var(--coral); }
</style>

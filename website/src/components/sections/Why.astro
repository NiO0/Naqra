---
import Button from "../ui/Button.astro";
import { why } from "../../data/home";
---
<section class="section why" id="why" aria-labelledby="why-title">
  <div class="container">
    <div class="why-head">
      <header class="sec-head">
        <p class="eyebrow" data-reveal="fade"><span>{why.eyebrow}</span></p>
        <h2 class="h2" id="why-title" data-split>
          لماذا تختار <span class="why-mark">نقرة<img class="why-circle" src="/art/doodle-circle.svg" alt="" width="170" height="100" /></span><br />
          لتحسين متجرك الإلكتروني؟
        </h2>
      </header>
      <div class="why-head-cta" data-reveal>
        <Button href={why.cta.href} variant="ghost">{why.cta.label}</Button>
      </div>
    </div>

    <ul class="bento">
      {why.cards.map((c, i) => (
        <li class:list={["bento-card", `bento-card--${i + 1}`]} data-tilt data-reveal="card">
          <span class="bc-glow" aria-hidden="true"></span>
          <div class="bc-top">
            <span class="bc-ico"><img src={`/art/icon-${c.icon}.svg`} alt="" width="34" height="34" /></span>
            <span class="bc-num mono" aria-hidden="true">0{i + 1}</span>
          </div>
          <div class="bc-copy">
            <h3 class="bc-title">{c.title}</h3>
            <p class="bc-text">{c.text}</p>
          </div>
          {i === 0 && (
            <div class="bc-art bc-stack" aria-hidden="true">
              {[0, 1, 2, 3, 4].map((n) => <i style={`--n:${n}`}><b></b><em></em></i>)}
            </div>
          )}
          {i === 2 && (
            <div class="bc-art bc-sparks" aria-hidden="true">
              <img src="/art/sparkle-lg.svg" alt="" width="44" height="44" />
              <img src="/art/sparkle-md.svg" alt="" width="26" height="26" />
              <img src="/art/sparkle-sm.svg" alt="" width="20" height="20" />
            </div>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why { background: var(--cream); padding-block: clamp(4.5rem, 6.8vw, 8.125rem); }
  .why-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .why-head .sec-head { gap: 0.25rem; }
  .why-head .h2 { line-height: 1.4; }
  .why-head-cta { color: var(--ink); }
  .why-mark { position: relative; display: inline-block; padding: 0.04em 0.32em; }
  .why-circle { position: absolute; top: -0.16em; left: -0.14em; width: calc(100% + 0.06em); height: 1.78em; pointer-events: none; }

  /* Bento: 888 | 703 over 640 | 950 (three tracks, cards span them) */
  .bento {
    display: grid; gap: clamp(0.9rem, 1.05vw, 1.25rem);
    grid-template-columns: minmax(0, 640fr) minmax(0, 228fr) minmax(0, 703fr);
    margin-top: clamp(2.5rem, 2.9vw, 3.5rem);
    perspective: 1200px;
  }
  .bento-card {
    --mx: 50%; --my: 50%;
    position: relative; overflow: hidden; isolation: isolate;
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    min-height: clamp(16rem, 16.7vw, 20rem); /* 320 */
    padding: clamp(1.5rem, 1.9vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: #fff; color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
    transform-style: preserve-3d;
    will-change: transform;
  }
  .bento-card--1 { grid-column: 1 / 3; background: var(--coral); color: #fff; box-shadow: none; }
  .bento-card--2 { grid-column: 3; }
  .bento-card--3 { grid-column: 1; background: var(--ink); color: #fff; box-shadow: none; }
  .bento-card--4 { grid-column: 2 / 4; }

  .bc-glow {
    position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity 0.4s;
    background: radial-gradient(360px circle at var(--mx) var(--my), rgb(242 110 83 / 0.12), transparent 60%);
  }
  .bento-card--1 .bc-glow { background: radial-gradient(360px circle at var(--mx) var(--my), rgb(255 255 255 / 0.2), transparent 60%); }
  .bento-card--3 .bc-glow { background: radial-gradient(360px circle at var(--mx) var(--my), rgb(242 110 83 / 0.25), transparent 60%); }
  .bento-card:hover .bc-glow { opacity: 1; }

  .bc-top { display: flex; align-items: center; justify-content: space-between; }
  .bc-ico {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px;
    background: var(--coral-100);
    transition: transform 0.6s var(--ease-spring);
  }
  .bento-card:hover .bc-ico { transform: rotate(-8deg) scale(1.06); }
  .bc-ico img { width: 34px; height: 34px; }
  .bento-card--1 .bc-ico { background: rgb(255 255 255 / 0.2); }
  .bento-card--3 .bc-ico { background: var(--coral); }
  .bc-num { font-size: var(--fs-mono); line-height: 1.5; }
  .bc-copy { display: grid; gap: 0.625rem; position: relative; z-index: 1; }
  .bento-card--1 .bc-copy { padding-left: min(34%, 300px); }
  .bc-title { font-size: var(--fs-h3); line-height: 1.5; }

  /* card art */
  .bc-art { position: absolute; pointer-events: none; }
  .bc-stack { direction: ltr; left: -4rem; top: 1.3rem; width: 19rem; display: grid; gap: 0.72rem; rotate: 8deg; }
  .bc-stack i {
    display: flex; align-items: center; gap: 0.8rem;
    padding: 0.8rem 0.96rem; border-radius: 18px; background: #fff;
    translate: calc(var(--n) * -6%) 0;
    transition: translate 0.7s var(--ease-out) calc(var(--n) * 40ms);
    box-shadow: 0 12.9px 25.7px -15.4px rgb(120 41 20 / 0.35);
  }
  .bento-card--1:hover .bc-stack i { translate: 0 0; }
  .bc-stack b { height: 10px; width: calc(244px - var(--n) * 10px); flex: none; border-radius: 99px; background: linear-gradient(90deg, var(--coral), var(--coral-200)); }
  .bc-stack em { width: 33px; height: 33px; border-radius: 10px; background: var(--coral-100); flex: none; }
  .bc-sparks { left: 0; top: 0; width: 15rem; height: 9rem; }
  .bc-sparks img { position: absolute; animation: twinkle 2.8s ease-in-out infinite; }
  .bc-sparks img:nth-child(1) { left: 120px; top: 40px; width: 44px; }
  .bc-sparks img:nth-child(2) { left: 80px; top: 96px; width: 26px; animation-delay: 0.6s; }
  .bc-sparks img:nth-child(3) { left: 186px; top: 34px; width: 20px; animation-delay: 1.2s; }
  @keyframes twinkle { 50% { transform: scale(0.6) rotate(25deg); opacity: 0.5; } }

  @media (max-width: 1000px) {
    .bento { grid-template-columns: 1fr; }
    .bento-card--1, .bento-card--2, .bento-card--3, .bento-card--4 { grid-column: 1; }
    .bento-card--1 .bc-copy { padding-left: 38%; }
  }
  @media (max-width: 560px) {
    .bento-card--1 .bc-copy { padding-left: 0; }
    .bc-stack { display: none; }
  }
</style>

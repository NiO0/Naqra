---
import SectionHead from "../ui/SectionHead.astro";
import { howItWorks } from "../../data/home";
---
<section class="section how" id="how-it-works" aria-labelledby="how-title">
  <div class="container">
    <SectionHead eyebrow={howItWorks.eyebrow} center id="how-title" sub={howItWorks.sub}>
      {howItWorks.headline}
    </SectionHead>

    <div class="journey" data-journey>
      <svg class="j-svg" aria-hidden="true" data-journey-svg>
        <path class="j-line" data-journey-line />
        <path class="j-track" data-journey-track />
      </svg>
      <div class="j-traveler" data-journey-traveler aria-hidden="true"><img src="/art/how-traveler.svg" alt="" width="80" height="82" /></div>

      <ol class="j-steps">
        {howItWorks.steps.map((s, i) => (
          <li class="j-step" data-step style={`--i:${i}`}>
            <span class="j-node" data-node aria-hidden="true"><span class="mono">{i + 1}</span></span>
            <article class="j-card">
              <p class="j-num mono">STEP {String(i + 1).padStart(2, "0")}</p>
              <h3 class="j-title">{s.title}</h3>
              <p class="j-text">{s.text}</p>

              <div class="j-ui" aria-hidden="true">
                {s.ui === "select" && (
                  <ul class="ui-select">
                    {(["tshirt", "bottle", "bag"] as const).map((k, n) => (
                      <li style={`--n:${n}`}>
                        <i class="ui-cb"><img src="/art/how-check-white.svg" alt="" width="14" height="14" /></i>
                        <img class="ui-th" src={`/art/thumb-${k}.svg`} alt="" width="34" height="34" />
                        <i class="ui-sk"></i>
                      </li>
                    ))}
                  </ul>
                )}
                {s.ui === "options" && (
                  <div class="ui-options">
                    {["العناوين", "الأوصاف", "بيانات SEO", "الصور"].map((o, n) => (
                      <span class="ui-opt" style={`--n:${n}`}><i class="ui-tg"></i>{o}</span>
                    ))}
                  </div>
                )}
                {s.ui === "ai" && (
                  <div class="ui-ai">
                    <span class="ui-ai-badge">جارٍ التحسين… <img src="/art/how-sparkle.svg" alt="" width="16" height="16" /></span>
                    <i class="ui-line" style="--w:400px"></i><i class="ui-line" style="--w:340px"></i><i class="ui-line" style="--w:250px"></i>
                  </div>
                )}
                {s.ui === "done" && (
                  <div class="ui-done">
                    <div class="ui-bar"><i></i></div>
                    <p>تم تطبيق التحسينات على 248 منتج <img src="/art/how-check-green.svg" alt="" width="18" height="18" /></p>
                  </div>
                )}
              </div>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .how { background: var(--paper); overflow: clip; }
  .how :global(.sec-head) { gap: 0.625rem; }
  .how :global(.h2) { line-height: 1.4; }
  .how :global(.lead) { max-width: 47.5rem; } /* 760 */

  .journey { position: relative; max-width: 77.5rem; margin: clamp(3rem, 3.5vw, 4.2rem) auto 0; padding-block: clamp(3rem, 6.25vw, 7.5rem) 4rem; }
  .j-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .j-svg path { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  /* solid coral progress line, cut into dashes by a white track laid over it */
  .j-line { stroke: var(--coral); stroke-width: 4; }
  .j-track { stroke: var(--paper); stroke-width: 6; stroke-dasharray: 3 9; stroke-linecap: butt; }
  .j-traveler {
    position: absolute; top: 0; left: 0; z-index: 3; width: 58px;
    pointer-events: none;
  }
  .j-traveler img { display: block; width: 100%; height: auto; }

  .j-steps { position: relative; z-index: 2; display: grid; gap: clamp(3rem, 6.5vw, 7.5rem); }
  .j-step { display: grid; grid-template-columns: minmax(0, 520fr) minmax(0, 200fr) minmax(0, 520fr); align-items: center; }
  /* Node: coral with an 8px tint ring when reached, white with a faded ring before */
  .j-node {
    grid-row: 1; grid-column: 2; justify-self: start; margin-inline: 34px;
    display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%;
    background: #fff; color: var(--muted);
    box-shadow: inset 0 0 0 2px var(--muted-2);
    transition: background-color 0.5s, color 0.5s, box-shadow 0.5s, transform 0.6s var(--ease-spring);
  }
  .j-step:nth-child(even) .j-node { justify-self: end; }
  .j-step.is-active .j-node { background: var(--coral); color: #fff; box-shadow: inset 0 0 0 8px var(--coral-100); }

  /* Card/Step: paper + line before, white + coral border + glow once reached */
  .j-card {
    grid-row: 1; grid-column: 1;
    display: grid; gap: 0.625rem;
    padding: clamp(1.4rem, 1.7vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--cream);
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition: box-shadow 0.6s, transform 0.8s var(--ease-out), background-color 0.6s, filter 0.6s;
    transform: translateY(14px);
  }
  .j-step:nth-child(even) .j-card { grid-column: 3; }
  .j-step.is-active .j-card {
    transform: none; background: #fff;
    box-shadow: inset 0 0 0 1.5px var(--coral);
    filter: drop-shadow(0 24px 24px rgb(242 110 84 / 0.18));
  }
  .j-num { font-weight: 600; line-height: 1.4; letter-spacing: 0.08em; color: var(--coral-700); }
  .j-title { font-size: var(--fs-h3); color: var(--ink); }
  .j-text { color: var(--muted); }

  /* Step mini-UIs (animate when the step becomes active) */
  .j-ui { padding: 0.875rem; border-radius: 16px; background: var(--cream); box-shadow: inset 0 0 0 1px var(--line); font-size: var(--fs-mono); line-height: 1.65; }

  .ui-select { display: grid; gap: 0.625rem; }
  .ui-select li { display: grid; grid-template-columns: auto 34px 1fr; align-items: center; gap: 0.75rem; }
  .ui-cb { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 6px; box-shadow: inset 0 0 0 1.5px var(--muted-2); transition: background-color 0.3s calc(var(--n) * 0.18s + 0.2s), box-shadow 0.3s calc(var(--n) * 0.18s + 0.2s); }
  .ui-cb img { width: 14px; height: 14px; transform: scale(0); transition: transform 0.35s var(--ease-spring) calc(var(--n) * 0.18s + 0.25s); }
  .is-active .ui-cb { background: var(--ink); box-shadow: none; }
  .is-active .ui-cb img { transform: scale(1); }
  .ui-th { display: block; width: 34px; height: 34px; }
  .ui-sk { display: block; height: 8px; border-radius: 99px; background: var(--line); width: min(100%, calc(220px - var(--n) * 40px)); }

  .ui-options { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ui-opt { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.75rem; border-radius: 99px; box-shadow: inset 0 0 0 1px var(--line-strong); color: var(--muted); transition: background-color 0.3s calc(var(--n) * 0.15s + 0.2s), color 0.3s calc(var(--n) * 0.15s + 0.2s), box-shadow 0.3s calc(var(--n) * 0.15s + 0.2s); }
  .ui-tg { position: relative; width: 26px; height: 15px; border-radius: 99px; background: #ddd4cd; transition: background-color 0.3s calc(var(--n) * 0.15s + 0.2s); }
  .ui-tg::after { content: ""; position: absolute; top: 2px; right: 2px; width: 11px; height: 11px; border-radius: 50%; background: #fff; transition: transform 0.4s var(--ease-spring) calc(var(--n) * 0.15s + 0.2s); }
  .is-active .ui-opt { background: var(--coral-100); color: var(--coral-700); box-shadow: inset 0 0 0 1px var(--coral); }
  .is-active .ui-tg { background: var(--coral); }
  .is-active .ui-tg::after { transform: translateX(-11px); }

  .ui-ai { display: grid; gap: 0.625rem; }
  .ui-ai-badge { display: inline-flex; align-items: center; gap: 0.375rem; justify-self: start; padding: 0.25rem 0.75rem; border-radius: 99px; background: var(--coral-100); color: var(--coral-700); }
  .ui-ai-badge img { width: 16px; height: 16px; }
  .is-active .ui-ai-badge img { animation: spin 2.4s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .ui-line {
    display: block; height: 9px; width: min(100%, var(--w)); border-radius: 99px;
    background: linear-gradient(90deg, #f1ebe5 0%, #f9c2b5 50%, #f1ebe5 100%);
    background-size: 300% 100%; background-position: 100% 0;
  }
  .is-active .ui-line { animation: shimmer 1.6s linear infinite; }
  @keyframes shimmer { to { background-position: -50% 0; } }

  .ui-done { display: grid; gap: 0.625rem; }
  .ui-bar { height: 8px; border-radius: 99px; background: var(--line); overflow: hidden; }
  .ui-bar i { display: block; height: 100%; width: 100%; background: var(--coral); transform-origin: right; transform: scaleX(0.08); transition: transform 1.6s var(--ease-out) 0.2s; }
  .is-active .ui-bar i { transform: scaleX(1); }
  .ui-done p { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--ink); }
  .ui-done img { width: 18px; height: 18px; }

  @media (max-width: 860px) {
    .j-step { grid-template-columns: 64px 1fr; }
    .j-node, .j-step:nth-child(even) .j-node { grid-column: 1; justify-self: center; align-self: start; margin: 1.4rem 0 0; }
    .j-card, .j-step:nth-child(even) .j-card { grid-column: 2; }
    .j-traveler { width: 44px; }
  }
</style>

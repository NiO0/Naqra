---
import SectionHead from "../ui/SectionHead.astro";
import { faqs as homeFaqs } from "../../data/home";

type Item = { q: string; a: string; todo?: boolean };
interface Props { eyebrow?: string; headline?: string; items?: Item[] }
const { eyebrow = homeFaqs.eyebrow, headline = homeFaqs.headline } = Astro.props;
// items flagged `todo` have no approved answer yet (see data/pricing.ts) and stay hidden
const items = (Astro.props.items ?? homeFaqs.items).filter((f: Item) => !f.todo);
---
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-side">
      <SectionHead eyebrow={eyebrow} id="faq-title">{headline}</SectionHead>
      <img class="faq-art" src="/art/illus-faq.svg" alt="" width="297" height="311" loading="lazy" data-reveal />
    </div>

    <div class="faq-list" data-accordion>
      {items.map((f, i) => (
        <div class="faq-item" data-acc-item data-reveal>
          <h3 class="faq-q">
            <button type="button" class="faq-btn" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-acc-btn>
              <span class="faq-n mono">{String(i + 1).padStart(2, "0")}</span>
              <span class="faq-qt">{f.q}</span>
              <span class="faq-ico" aria-hidden="true"><img class="is-closed" src="/art/icon-plus.svg" alt="" width="22" height="22" /><img class="is-open" src="/art/icon-plus-white.svg" alt="" width="22" height="22" /></span>
            </button>
          </h3>
          <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} data-acc-panel hidden>
            <p>{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--paper); padding-block: clamp(5rem, 8.2vw, 9.9rem); } /* 158 */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 440fr) minmax(0, 1099fr); gap: clamp(2rem, 4.2vw, 5rem); align-items: start; }
  .faq-side { position: sticky; top: calc(var(--pill-h, 5rem) + 3rem); display: grid; gap: 2.25rem; }
  .faq-side :global(.sec-head) { gap: 1.625rem; }
  .faq-side :global(.h2) { line-height: 1.41; letter-spacing: -0.01em; }
  .faq-art { justify-self: center; width: min(100%, 18.5rem); height: auto; }

  .faq-list { display: grid; border-top: 1px solid var(--line-strong); }
  .faq-item { border-bottom: 1px solid var(--line-strong); }
  .faq-btn {
    width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1rem;
    padding: 1.375rem 0; text-align: start;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.05rem, 1.05vw, 1.25rem); line-height: 1.5;
    color: var(--ink);
    transition: color 0.3s;
  }
  .faq-btn:hover { color: var(--coral-700); }
  .faq-n { color: var(--muted); font-weight: 400; }
  .faq-ico {
    position: relative;
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    background: var(--cream); box-shadow: inset 0 0 0 1px var(--line);
    transition: transform 0.5s var(--ease-spring), background-color 0.35s, box-shadow 0.35s;
  }
  .faq-ico img { grid-area: 1 / 1; width: 22px; height: 22px; transition: opacity 0.3s; }
  .faq-ico .is-open { opacity: 0; }
  .faq-btn[aria-expanded="true"] .faq-ico { transform: rotate(135deg); background: var(--coral); box-shadow: none; }
  .faq-btn[aria-expanded="true"] .is-open { opacity: 1; }
  .faq-btn[aria-expanded="true"] .is-closed { opacity: 0; }
  .faq-a { overflow: hidden; }
  .faq-a p { padding: 0 2.5rem 1.625rem 3.75rem; color: var(--muted); }

  @media (max-width: 900px) {
    .faq-grid { grid-template-columns: 1fr; }
    .faq-side { position: static; }
    .faq-art { width: 11rem; }
    .faq-a p { padding-inline: 0; }
  }
</style>

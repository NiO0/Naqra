---
import SectionHead from "../ui/SectionHead.astro";
import CompareBoard from "../mock/CompareBoard.astro";
import BeforeAfter from "../mock/BeforeAfter.astro";
import { inAction } from "../../data/home";
const ex = inAction.example;
---
<section class="section in-action" id="in-action" aria-labelledby="ia-title">
  <div class="container">
    <img class="ia-art" src="/art/illus-action.svg" alt="" width="527" height="251" loading="lazy" data-reveal />
    <SectionHead eyebrow={inAction.eyebrow} center id="ia-title">
      {`${inAction.headline.before} ${inAction.headline.mark}`}
    </SectionHead>

    <div class="ia-grid">
      <CompareBoard rows={inAction.rows} manualLabel={inAction.manualLabel} naqraLabel={inAction.naqraLabel} />
      <BeforeAfter example={ex} />
    </div>
  </div>
</section>

<style>
  .in-action { background: var(--paper); padding-top: clamp(2rem, 4vw, 5rem); }
  .ia-art { display: block; width: min(60%, 33rem); height: auto; margin: 0 auto clamp(0.5rem, 1vw, 1rem); }
  .in-action :global(.h2) { max-width: 82.25rem; letter-spacing: -0.04em; } /* 1316 */

  /* Figma "Compare grid": the before/after stage is 330 tall */
  .ia-grid :global(.ba-stage) { min-height: clamp(14rem, 17.2vw, 20.6rem); }
  .ia-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 1.9vw, 2.25rem);
    max-width: 77.5rem; margin: clamp(2.5rem, 3.4vw, 4rem) auto 0; /* 1240 */
    align-items: stretch;
  }

  @media (max-width: 960px) {
    .ia-grid { grid-template-columns: 1fr; }
  }
</style>

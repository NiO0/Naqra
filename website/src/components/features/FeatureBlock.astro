---
// One section of the Features page: number + Latin label, headline (+ "قريبًا" chip), intro,
// the section's points and a visual (default slot). Points render as a ruled list, or as cards.
import type { FeatureSection } from "../../data/features";
interface Props {
  section: FeatureSection;
  index: number;
  art: string; // /public/art/f-*.svg "feature orb"
  tone?: "paper" | "cream" | "dark";
  points?: "list" | "cards" | "none";
  reverse?: boolean; // visual on the reading-start side
  stack?: boolean; // visual under the copy, full width
}
const { section: s, index, art, tone = "paper", points = "list", reverse = false, stack = false } = Astro.props;
const headId = `${s.id}-title`;
---
<section
  class:list={["section", "fblock", `fblock--${tone}`, reverse && "is-reverse", stack && "is-stack"]}
  id={s.id}
  data-theme={tone === "dark" ? "dark" : undefined}
  aria-labelledby={headId}
>
  <div class="container fb-grid">
    <div class="fb-copy">
      <div class="fb-label" data-reveal="fade">
        <img class="fb-art" src={`/art/${art}.svg`} alt="" width="115" height="115" loading="lazy" />
        <p class="mono"><span class="fb-n">{String(index).padStart(2, "0")}</span> / {s.latin}</p>
      </div>
      <h2 class="h2 fb-title" id={headId}>
        <span data-split>{s.headline}</span>
        {s.soon && <span class="chip chip--soon fb-soon" data-reveal="fade">قريبًا</span>}
      </h2>
      <p class="lead fb-sub" data-reveal>{s.sub}</p>

      {points === "list" && s.points.length > 0 && (
        <ol class="fb-points">
          {s.points.map((p, i) => (
            <li class="fb-point" data-reveal>
              <span class="fb-pn mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="fb-pt">{p.title}</h3>
                <p class="fb-pd">{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
      <slot name="copy" />
    </div>

    <div class="fb-visual">
      <slot />
    </div>

    {points === "cards" && s.points.length > 0 && (
      <ol class:list={["fb-cards", `has-${s.points.length}`]}>
        {s.points.map((p, i) => (
          <li class="fb-card" data-reveal="card">
            <span class="fb-card-n mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="fb-pt">{p.title}</h3>
            <p class="fb-pd">{p.text}</p>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .fblock { scroll-margin-top: 4.5rem; } /* room for the sticky jump line */
  .fblock--paper { background: var(--paper); }
  .fblock--cream { background: var(--cream); }
  .fblock--dark { background: var(--ink); color: #fff; }

  .fb-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas: "copy visual" "cards cards";
    gap: clamp(2rem, 4vw, 5rem) clamp(2rem, 4.5vw, 6rem); align-items: center;
  }
  .is-reverse .fb-grid { grid-template-areas: "visual copy" "cards cards"; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .is-stack .fb-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "visual" "cards"; }
  .is-stack .fb-copy { max-width: 56rem; }
  .fb-copy { grid-area: copy; display: grid; justify-items: start; gap: 1rem; min-width: 0; }
  .fb-visual { grid-area: visual; min-width: 0; }
  .fb-visual:empty { display: none; }

  .fb-label { display: flex; align-items: center; gap: 0.9rem; color: var(--muted); }
  .fblock--dark .fb-label { color: var(--muted-2); }
  .fb-art { width: clamp(3.75rem, 4.6vw, 5.4rem); height: auto; flex: none; }
  .fblock--dark .fb-art { background: var(--cream); border-radius: 50%; padding: 0.4rem; }
  .fb-n { color: var(--coral-700); font-weight: 600; }
  .fblock--dark .fb-n { color: var(--coral); }

  .fb-title { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4em 0.6em; }
  .fb-soon { font-family: var(--font-body); font-size: 0.9rem; letter-spacing: 0; }
  .fblock--dark .fb-soon { background: var(--coral); color: #fff; }
  .fb-sub { max-width: 44rem; }
  .fblock--dark .fb-sub { color: var(--muted-2); }

  /* ruled list, like lines in a notebook */
  .fb-points { display: grid; width: 100%; margin-top: 0.75rem; border-top: 1px solid var(--line-strong); }
  .fb-point { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.5rem 1rem; padding-block: 1rem; border-bottom: 1px solid var(--line-strong); }
  .fblock--dark .fb-points, .fblock--dark .fb-point { border-color: rgb(255 255 255 / 0.2); }
  .fb-pn { color: var(--coral-700); font-weight: 600; font-size: 0.95rem; line-height: 1.9; }
  .fblock--dark .fb-pn { color: var(--coral); }
  .fb-pt { font-size: clamp(1.05rem, 1.1vw, 1.25rem); line-height: 1.55; }
  .fb-pd { color: var(--muted); }
  .fblock--dark .fb-pd { color: var(--muted-2); }

  .fb-cards { grid-area: cards; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.9rem, 1.2vw, 1.4rem); }
  .fb-cards.has-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fb-card {
    display: grid; align-content: start; gap: 0.5rem;
    padding: clamp(1.25rem, 1.6vw, 1.9rem); border-radius: var(--radius-lg);
    background: var(--cream); box-shadow: inset 0 0 0 1px var(--line);
  }
  .fblock--cream .fb-card { background: #fff; }
  .fblock--dark .fb-card { background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14); }
  .fb-card-n { font-size: clamp(1.6rem, 1.9vw, 2.25rem); font-weight: 600; line-height: 1.2; color: var(--coral); }

  @media (max-width: 1100px) {
    .fb-cards, .fb-cards.has-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .fb-grid, .is-reverse .fb-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "visual" "cards"; }
  }
  @media (max-width: 560px) {
    .fb-cards, .fb-cards.has-3 { grid-template-columns: minmax(0, 1fr); }
  }
</style>

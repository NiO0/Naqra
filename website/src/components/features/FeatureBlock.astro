---
// One section of the Features page: big coral number, headline (+ "قريبًا SOON" stamp), intro,
// the section's points and a visual (default slot) on a tilted paper sheet. Points render as a
// ruled list, or as tilted sticky-note cards.
import type { FeatureSection } from "../../data/features";
interface Props {
  section: FeatureSection;
  index: number;
  tone?: "paper" | "cream" | "dark";
  points?: "list" | "cards" | "none";
  reverse?: boolean; // visual on the reading-start side
  stack?: boolean; // visual under the copy, full width
  sheet?: boolean; // tilted paper sheet + sparkle behind the visual
  tight?: boolean; // shorter vertical padding
}
const { section: s, index, tone = "paper", points = "list", reverse = false, stack = false, sheet = true, tight = false } = Astro.props;
const headId = `${s.id}-title`;
---
<section
  class:list={["section", "fblock", `fblock--${tone}`, reverse && "is-reverse", stack && "is-stack", tight && "is-tight"]}
  id={s.id}
  data-theme={tone === "dark" ? "dark" : undefined}
  aria-labelledby={headId}
>
  <div class="container fb-grid">
    <div class="fb-copy">
      <p class="fb-n" data-reveal="fade" aria-hidden="true">{String(index).padStart(2, "0")}</p>
      <div class="fb-head">
        <h2 class="h2 fb-title" id={headId}><span data-split>{s.headline}</span></h2>
        {s.soon && <p class="fb-stamp" data-reveal="fade"><span class="mono" aria-hidden="true">SOON</span> قريبًا</p>}
      </div>
      <p class="lead fb-sub" data-reveal>{s.sub}</p>

      {points === "list" && s.points.length > 0 && (
        <ol class="fb-points">
          {s.points.map((p, i) => (
            <li class="fb-point" data-reveal>
              <span class="fb-pn mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="fb-pt">{p.title}</h3>
                <p class="fb-pd">{p.text}</p>
              </div>
            </li>
          ))}
        </ol>
      )}
      <slot name="copy" />
    </div>

    <div class:list={["fb-visual", sheet && "has-sheet"]}>
      <slot />
      {sheet && <img class="fb-sparkle" src="/art/sparkle-md.svg" alt="" width="42" height="42" aria-hidden="true" />}
    </div>

    {points === "cards" && s.points.length > 0 && (
      <ol class:list={["fb-cards", `has-${s.points.length}`]}>
        {s.points.map((p, i) => (
          <li class="fb-card" style={`--i:${i}`} data-reveal="card">
            <span class="fb-card-n mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="fb-pt">{p.title}</h3>
            <p class="fb-pd">{p.text}</p>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>

<style>
  .fblock { padding-block: clamp(4rem, 7.1vw, 8.5rem); } /* 136 */
  .fblock.is-tight { padding-block: clamp(2.5rem, 3.4vw, 4.06rem); } /* 65 */
  :global(.phero) + .fblock { padding-block: clamp(2rem, 2.76vw, 3.3rem); } /* right under the hero: 53 */
  .fblock--paper { background: var(--paper); --sheet: var(--coral-100); --card-alt: var(--cream); }
  .fblock--cream { background: var(--cream); --sheet: rgb(249 194 181 / 0.55); --card-alt: #fff; }
  .fblock--dark { background: var(--ink); color: #fff; --sheet: #fff; }

  .fb-grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas: "copy visual" "cards cards";
    gap: clamp(2rem, 5.2vw, 6.25rem) clamp(2rem, 4.5vw, 6rem); align-items: center;
  }
  .is-reverse .fb-grid { grid-template-areas: "visual copy" "cards cards"; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .is-stack .fb-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "visual" "cards"; }
  .is-stack .fb-copy { max-width: 56rem; }
  .fb-copy { grid-area: copy; display: grid; justify-items: start; gap: 2rem; min-width: 0; }
  .fb-visual { grid-area: visual; position: relative; isolation: isolate; min-width: 0; }

  /* Cascadia Mono SemiBold 60, coral */
  .fb-n { font-family: var(--font-mono); font-weight: 600; font-size: clamp(2.5rem, 3.125vw, 3.75rem); line-height: 1; letter-spacing: -0.02em; color: var(--coral); margin-bottom: -0.25rem; }

  .fb-head { position: relative; width: 100%; }
  .fb-title { max-width: 47rem; }
  /* rubber stamp at the end of the headline's first line */
  .fb-stamp {
    position: absolute; top: -1.6rem; inset-inline-end: 2.5rem; rotate: -6deg;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.2rem 0.6rem; border: 2px dashed var(--coral); border-radius: 10px;
    background: var(--coral-50); color: var(--coral-700);
    font-weight: 700; font-size: 1rem; line-height: 1.6; white-space: nowrap;
  }
  .fb-stamp .mono { font-weight: 700; font-size: 0.75rem; letter-spacing: 0.12em; }
  .fblock--dark .fb-stamp { background: none; color: var(--coral); }
  .fb-sub { max-width: 44.375rem; } /* 710 */
  .fblock--dark .fb-sub { color: var(--muted-2); }

  /* paper sheet tilted out from behind the visual, towards the copy */
  .has-sheet::before {
    content: ""; position: absolute; z-index: -1; inset: 0; margin: auto;
    width: 97%; height: 99%;
    border-radius: var(--radius-lg); background: var(--sheet);
    translate: 4.6% 6.5%; rotate: 3deg;
  }
  .is-reverse .has-sheet::before { translate: -4.6% 6.5%; rotate: -3deg; }
  .fb-sparkle { position: absolute; z-index: 2; top: -1.1rem; left: -0.9rem; width: 2.6rem; height: auto; pointer-events: none; }

  /* ruled list, like lines in a notebook */
  .fb-points { display: grid; width: 100%; margin-top: 0.75rem; border-top: 1px solid var(--line-strong); }
  .fb-point { display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.5rem 1rem; padding-block: 1rem; border-bottom: 1px solid var(--line-strong); }
  .fblock--dark .fb-points, .fblock--dark .fb-point { border-color: #fff; }
  .fb-pn { color: var(--coral-700); font-weight: 600; font-size: 0.95rem; line-height: 1.9; }
  .fblock--dark .fb-pn { color: var(--coral); }
  .fb-pt { font-size: clamp(1.05rem, 1.1vw, 1.25rem); line-height: 1.55; }
  .fb-pd { color: var(--muted); }
  .fblock--dark .fb-pd { color: var(--muted-2); }

  /* sticky notes: coral / paper / coral, each at its own tilt */
  .fb-cards { grid-area: cards; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 1.9vw, 2.25rem); }
  .fb-cards.has-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .fb-card {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: start; gap: 0.5rem 1rem;
    padding: clamp(1.25rem, 1.6vw, 1.9rem);
    background: var(--coral); color: var(--ink);
    filter: drop-shadow(0 22px 20px rgb(125 38 20 / 0.3));
    rotate: -2.2deg;
  }
  .fb-card:nth-child(3n + 2) { background: var(--card-alt); box-shadow: inset 0 0 0 1px var(--line); rotate: 1.8deg; }
  .fb-card:nth-child(3n + 3) { rotate: -1.4deg; }
  .fb-card-n { grid-column: 2; grid-row: 1; justify-self: end; font-size: clamp(1.6rem, 1.9vw, 2.25rem); font-weight: 600; line-height: 1.2; color: #fff; }
  .fb-card:nth-child(3n + 2) .fb-card-n { color: var(--coral); }
  .fb-card .fb-pt { grid-column: 1 / -1; margin-top: 0.4rem; }
  .fb-card .fb-pd { grid-column: 1 / -1; color: var(--ink); opacity: 0.85; }
  .fb-card:nth-child(3n + 2) .fb-pd { color: var(--muted); opacity: 1; }

  @media (max-width: 1100px) {
    .fb-cards, .fb-cards.has-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .fb-grid, .is-reverse .fb-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "copy" "visual" "cards"; }
  }
  @media (max-width: 640px) {
    /* the stamp sits above the headline instead of on it */
    .fb-head { display: flex; flex-direction: column-reverse; align-items: flex-start; gap: 0.6rem; }
    .fb-stamp { position: static; margin-inline-start: 0.4rem; }
  }
  @media (max-width: 560px) {
    .fb-cards, .fb-cards.has-3 { grid-template-columns: minmax(0, 1fr); }
  }
</style>

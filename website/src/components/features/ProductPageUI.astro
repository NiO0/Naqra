---
// On-page SEO visual: an illustrative product page with numbered pins on the elements Naqra
// improves. Pin numbers match the section's points list (1 title & description, 2 image alt text,
// 3 URL & internal links, 4 page structure).
---
<figure class="ppage" data-inview aria-hidden="true">
  <div class="pp-bar">
    <span class="pp-dots"><i></i><i></i><i></i></span>
    <span class="pp-urlwrap"><span class="pp-url mono">store.com/products/stainless-water-bottle-500ml</span><b class="pin" style="--d:2">3</b></span>
  </div>
  <div class="pp-body">
    <div class="pp-media">
      <img src="/art/thumb-bottle.svg" alt="" width="34" height="34" />
      <span class="pp-alt mono">alt="قارورة مياه ستانلس ستيل 500 مل"</span>
      <b class="pin" style="--d:1">2</b>
    </div>
    <div class="pp-info">
      <p class="pp-crumbs mono">الرئيسية › قوارير › ستانلس</p>
      <p class="pp-h1"><span class="pp-hx mono">H1</span>قارورة مياه ستانلس ستيل 500 مل<b class="pin" style="--d:0">1</b></p>
      <span class="pp-line" style="--w:94%"></span>
      <span class="pp-line" style="--w:80%"></span>
      <div class="pp-h2"><span class="pp-hx mono">H2</span><span class="pp-line" style="--w:46%"></span><b class="pin" style="--d:3">4</b></div>
      <span class="pp-line" style="--w:88%"></span>
      <div class="pp-h2"><span class="pp-hx mono">H2</span><span class="pp-line" style="--w:36%"></span></div>
      <div class="pp-links"><span>قوارير زجاج</span><span>أكواب حرارية</span></div>
    </div>
  </div>
</figure>

<style>
  .ppage {
    border-radius: var(--radius-lg); overflow: visible;
    background: #fff; box-shadow: inset 0 0 0 1px var(--line), 0 40px 80px -50px rgb(125 38 20 / 0.35);
  }
  .pp-bar { display: flex; align-items: center; gap: 0.9rem; padding: 0.8rem 1.1rem; border-bottom: 1px solid var(--line); }
  .pp-dots { display: flex; gap: 5px; }
  .pp-dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .pp-urlwrap { position: relative; flex: 1; min-width: 0; display: flex; }
  .pp-url {
    flex: 1; min-width: 0;
    padding: 0.35rem 0.8rem; border-radius: 999px; background: var(--cream);
    font-size: 0.72rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pp-body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(1rem, 1.6vw, 1.75rem); padding: clamp(1rem, 1.6vw, 1.75rem); }
  .pp-media { position: relative; align-self: start; display: grid; gap: 0.6rem; }
  .pp-media > img { width: 100%; height: auto; border-radius: 18px; }
  .pp-alt {
    padding: 0.3rem 0.6rem; border-radius: 8px; background: var(--ink); color: #fff;
    font-size: 0.66rem; line-height: 1.6; direction: ltr; text-align: left; overflow-wrap: anywhere;
  }
  .pp-info { display: grid; align-content: start; gap: 0.6rem; min-width: 0; }
  .pp-crumbs { font-size: 0.68rem; color: var(--muted); direction: rtl; }
  .pp-h1 { position: relative; display: flex; align-items: center; gap: 0.5rem; font-weight: 600; font-size: clamp(0.95rem, 1.1vw, 1.15rem); line-height: 1.5; }
  .pp-hx { flex: none; padding: 0.05rem 0.4rem; border-radius: 6px; background: var(--coral-100); color: var(--coral-700); font-size: 0.68rem; font-weight: 600; }
  .pp-h2 { position: relative; display: flex; align-items: center; gap: 0.5rem; margin-top: 0.3rem; }
  .pp-h2 .pp-line { height: 10px; background: var(--muted-2); }
  .pp-line { display: block; height: 8px; width: var(--w); border-radius: 99px; background: var(--line); }
  .pp-links { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
  .pp-links span { padding: 0.15rem 0.6rem; border-radius: 99px; font-size: 0.72rem; color: #1f3fae; box-shadow: inset 0 0 0 1px var(--line); text-decoration: underline; text-underline-offset: 3px; }

  /* numbered pins pop in one by one */
  .pin {
    position: absolute; z-index: 2; inset-inline-start: -0.9rem; top: -0.9rem;
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    background: var(--coral); color: #fff; font-family: var(--font-mono); font-size: 0.8rem; font-weight: 700;
    box-shadow: 0 0 0 5px rgb(242 110 83 / 0.22);
    transform: scale(0); transition: transform 0.5s var(--ease-spring) calc(var(--d) * 0.25s + 0.2s);
  }
  .pp-h1 .pin { inset-inline-start: auto; inset-inline-end: -1.6rem; top: 50%; margin-top: -14px; }
  .pp-h2 .pin { inset-inline-start: auto; inset-inline-end: -1.6rem; top: 50%; margin-top: -14px; }
  .pp-urlwrap .pin { inset-inline-start: auto; inset-inline-end: -0.4rem; top: -0.9rem; }
  .is-inview .pin { transform: scale(1); }

  @media (max-width: 560px) {
    .pp-body { grid-template-columns: minmax(0, 1fr); }
    .pp-media { width: 60%; }
    .pp-h1 .pin, .pp-h2 .pin { inset-inline-end: -0.4rem; }
  }
</style>

---
// Sticky jump line of the Features page: one tab per section, highlighted while it's in view
// (scripts/feature-nav.ts). Scrolls sideways on small screens instead of wrapping.
import Icon from "../ui/Icon.astro";
interface Props { items: { id: string; label: string; icon: string }[] }
const { items } = Astro.props;
---
<nav class="fnav" aria-label="أقسام المزايا" data-fnav>
  <div class="container">
    <ol class="fnav-track">
      {items.map((it) => (
        <li>
          <a href={`#${it.id}`} class="fnav-link">
            <span class="fnav-ico"><Icon name={it.icon} /></span>
            <span class="fnav-label">{it.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .fnav {
    /* sits just under the floating header pills; slides up when the header hides on scroll */
    --hdr: calc(clamp(0.75rem, 1.67vw, 2rem) + clamp(3.6rem, 4.17vw, 5rem));
    position: sticky; z-index: 40; top: calc(var(--hdr) + 0.6rem);
    margin-top: calc(-1 * clamp(1.5rem, 3vw, 3rem));
    transition: top 0.6s var(--ease-out);
  }
  :global(.hdr-hidden) .fnav { top: 0.6rem; }

  .fnav-track {
    display: flex; gap: 0.25rem;
    padding: 0.4rem; border-radius: 28px;
    background: rgb(255 255 255 / 0.9);
    box-shadow: inset 0 0 0 1px var(--line), 0 13px 16px rgb(125 38 20 / 0.06);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .fnav-track::-webkit-scrollbar { display: none; }
  .fnav-track li { flex: 1 1 0; min-width: 0; }
  .fnav-link {
    display: flex; align-items: center; gap: 0.55rem;
    height: 100%; padding: 0.4rem 0.5rem 0.4rem 0.75rem; border-radius: 22px;
    font-size: 0.8125rem; font-weight: 500; line-height: 1.45; color: var(--ink);
    transition: background-color 0.35s, color 0.35s;
  }
  .fnav-link:hover { background: var(--coral-50); }
  .fnav-ico { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--coral-100); color: var(--coral-700); flex: none; transition: background-color 0.35s, color 0.35s, transform 0.5s var(--ease-spring); }
  .fnav-ico :global(.icon) { width: 20px; height: 20px; }
  .fnav-link[aria-current] { background: var(--ink); color: #fff; }
  .fnav-link[aria-current] .fnav-ico { background: var(--coral); color: #fff; transform: rotate(-8deg); }

  /* narrower screens: one line per tab, the line scrolls sideways */
  @media (max-width: 1200px) {
    .fnav-track { border-radius: 999px; }
    .fnav-track li { flex: 0 0 auto; }
    .fnav-link { white-space: nowrap; border-radius: 999px; padding-inline-end: 1rem; }
  }
  @media (max-width: 600px) {
    .fnav-link { font-size: 0.8rem; gap: 0.4rem; }
    .fnav-ico { width: 28px; height: 28px; }
  }
</style>

---
// Store speed visual: a hand-drawn performance gauge whose needle swings from red to green
// when it scrolls into view. Illustrative, shows no measured score.
---
<figure class="gauge" data-inview aria-hidden="true">
  <svg viewBox="0 0 320 190" class="g-svg">
    <defs>
      <linearGradient id="g-arc" x1="0" x2="1" y1="0" y2="0">
        <stop offset="0" stop-color="#c9472b" />
        <stop offset="0.5" stop-color="#f2b33d" />
        <stop offset="1" stop-color="#1e7f55" />
      </linearGradient>
    </defs>
    <path class="g-track" d="M30 165 A130 130 0 0 1 290 165" />
    <path class="g-arc" d="M30 165 A130 130 0 0 1 290 165" pathLength="100" />
    {[...Array(11)].map((_, i) => {
      const a = Math.PI - (i / 10) * Math.PI;
      const r1 = 108, r2 = i % 5 ? 98 : 92;
      return <line class="g-tick" x1={160 + r1 * Math.cos(a)} y1={165 - r1 * Math.sin(a)} x2={160 + r2 * Math.cos(a)} y2={165 - r2 * Math.sin(a)} />;
    })}
    <g class="g-needle">
      <path d="M160 165 L160 62" />
      <circle cx="160" cy="165" r="11" />
    </g>
  </svg>
  <div class="g-labels mono"><span class="g-slow">SLOW</span><span class="g-fast">FAST</span></div>
  <img class="g-sparks" src="/art/hero-sparks.svg" alt="" width="60" height="46" />
</figure>

<style>
  .gauge {
    position: relative; display: grid; gap: 0.5rem;
    padding: clamp(1.5rem, 2.4vw, 2.75rem) clamp(1.25rem, 2.4vw, 2.75rem) clamp(1.25rem, 1.8vw, 2rem);
    border-radius: var(--radius-lg);
    background: #fff; box-shadow: inset 0 0 0 1px var(--line), 0 40px 80px -50px rgb(125 38 20 / 0.35);
  }
  .g-svg { width: 100%; height: auto; overflow: visible; }
  .g-track { fill: none; stroke: var(--sand); stroke-width: 22; stroke-linecap: round; }
  .g-arc { fill: none; stroke: url(#g-arc); stroke-width: 22; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 82; transition: stroke-dashoffset 2s var(--ease-out) 0.3s; }
  .is-inview .g-arc { stroke-dashoffset: 8; }
  .g-tick { stroke: var(--muted-2); stroke-width: 2.5; stroke-linecap: round; }
  .g-needle { transform-origin: 160px 165px; transform: rotate(-72deg); transition: transform 2s cubic-bezier(0.34, 1.3, 0.64, 1) 0.3s; }
  .is-inview .g-needle { transform: rotate(68deg); }
  .g-needle path { stroke: var(--ink); stroke-width: 6; stroke-linecap: round; }
  .g-needle circle { fill: var(--ink); stroke: #fff; stroke-width: 4; }
  .g-labels { display: flex; justify-content: space-between; direction: ltr; font-size: 0.75rem; }
  .g-slow { color: var(--coral-700); }
  .g-fast { color: var(--ok); font-weight: 600; }
  .g-sparks { position: absolute; top: 1rem; right: 1.25rem; width: 3rem; height: auto; opacity: 0; transition: opacity 0.5s 2s; }
  .is-inview .g-sparks { opacity: 1; }
</style>

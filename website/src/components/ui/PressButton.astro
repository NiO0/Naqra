---
// Hand-drawn "one click": a hand pressing a big coral button, sized to sit inside a line of text.
// Animated by scripts/hero.ts (.hp-hand presses, .hp-cap sinks, .spark strokes burst).
interface Props { class?: string }
const { class: cls = "" } = Astro.props;
---
<svg class:list={["press", cls]} viewBox="0 0 150 130" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <!-- sparkles -->
  <g class="hp-deco">
    <path class="hp-diamond" d="M22 33.5c1.6 4.2 3.7 8 6.8 12.2-3.3 4-5.4 7.8-6.9 12.4-1.7-4.4-3.9-8.3-7-12.3 3.1-4.1 5.3-8 7.1-12.3z" />
    <path class="hp-outline" d="M133.5 88.5c1 2.6 2.3 5 4.2 7.6-2 2.4-3.3 4.8-4.3 7.7-1-2.7-2.4-5.2-4.3-7.7 1.9-2.5 3.3-5 4.4-7.6z" />
    <path class="hp-outline" d="M117 115.5l.2 9.4M112.6 117.8l9 5.2M121.4 117.6l-8.6 5.4" />
    <circle class="hp-dot" cx="44" cy="22" r="1.8" />
    <circle class="hp-dot" cx="10" cy="76" r="1.5" />
  </g>

  <!-- base plate -->
  <path class="hp-plate" d="M18.4 104.2c-.6-7.4 22.6-13.5 51.8-13.4 29.2.1 52.4 6 51.8 13.3-.4 7.2-23.6 12.9-52 12.9-28.6 0-51.2-5.6-51.6-12.8z" />
  <path class="hp-hatch" d="M85 124.5l4.6-6.4M92.4 124.6l4.6-6.4M99.8 124.4l4.6-6.4" />

  <!-- the button -->
  <g class="hp-cap">
    <path class="hp-side" d="M40 84v11c0 4.7 13.4 8.5 30 8.5s30-3.8 30-8.5V84" />
    <g class="hp-top">
      <path class="hp-face" d="M40 84c-.2-4.6 13.4-8.6 30-8.6s30.3 3.9 30 8.6c-.2 4.7-13.6 8.5-30 8.5S40.2 88.7 40 84z" />
      <path class="hp-shine" d="M49.6 81.4c4-2.4 10.6-3.4 17-3.5" />
    </g>
  </g>

  <!-- impact sparks: burst on every press -->
  <g class="spark" data-origin="100% 100%"><path d="M46.6 70.6l-8.8-8.2" /></g>
  <g class="spark" data-origin="100% 50%"><path d="M41.8 78.6l-11.6-.8" /></g>
  <g class="spark" data-origin="50% 100%"><path d="M54.4 66.8l-3.2-10.6" /></g>

  <!-- hand: drawn pointing straight down with the fingertip at 0,0, then rotated into place -->
  <g transform="translate(70 84) rotate(32)">
    <g class="hp-hand" transform="translate(0 -7)">
      <path class="hp-sleeve" d="M-13.8 -76L-17 -132H31L27.4 -76z" />
      <path class="hp-cuff" d="M-11.6 -57.6C-12.6 -63.4 -13.4 -69.6 -13.8 -76H27.4C26.6 -69.8 25.6 -63.6 24.4 -57.8 12.4 -59.2 .4 -59.2 -11.6 -57.6z" />
      <path class="hp-skin" d="M-7 -5C-7 -1.5 -3.8 1 0 1S7 -1.5 7 -5L7.5 -24C9 -27 13 -27.5 16 -26 21 -24 25 -27 25 -32 28 -33 30 -37 29 -41 31 -43 32 -48 30 -52 29 -57 26 -60 22 -60.5 12 -62.5 0 -62.5 -9 -60.5 -14 -58 -15 -50 -13 -43 -12 -38 -9 -33 -7 -29z" />
      <path class="hp-line" d="M8 -27.5C12 -30.5 18 -31.6 24.6 -31.6M12 -39C18 -40.6 24 -41 29 -41M-13 -46C-5 -47.6 5 -45 10 -39.5 12.5 -36.8 11.5 -33.5 8.6 -32.6M-3.8 -15.4C-1.4 -14 1.4 -14 3.8 -15.4M-3.4 -4.4C-3.2 -7.4 3.2 -7.4 3.4 -4.4" />
    </g>
  </g>
</svg>

<style>
  .press {
    overflow: hidden;
    fill: none; stroke: var(--ink); stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round;
  }
  .hp-plate, .hp-skin, .hp-sleeve { fill: #fff; }
  .hp-cuff { fill: var(--coral-100); }
  .hp-side { fill: var(--coral-700); }
  .hp-face { fill: var(--coral); }
  .hp-shine { stroke: #fff; stroke-width: 2.4; opacity: 0.85; }
  .hp-diamond { fill: var(--coral); }
  .hp-hatch, .spark { stroke: var(--coral); stroke-width: 3.6; }
  .hp-dot { fill: var(--ink); stroke: none; }
  .hp-line { stroke-width: 2.6; }
  .press :global(.spark) { transform-box: fill-box; }
  .hp-side { transform-box: fill-box; transform-origin: 50% 100%; }
</style>

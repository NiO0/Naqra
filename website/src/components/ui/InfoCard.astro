---
// Numbered card in the home "Challenges" style (cream paper, 1px line, radius 32, coral mono number).
// tone: cream (default) | white | coral | ink. `icon` is a /public/art/icon-*.svg name; `glyph` an Icon.astro name.
import Icon from "./Icon.astro";
interface Props {
  title: string;
  text?: string;
  n?: number;
  icon?: string;
  glyph?: string;
  tone?: "cream" | "white" | "coral" | "ink";
  as?: "article" | "li" | "div";
  class?: string;
}
const { title, text, n, icon, glyph, tone = "cream", as: Tag = "article", class: cls = "" } = Astro.props;
---
<Tag class:list={["icard", `icard--${tone}`, cls]} data-reveal="card">
  {(n !== undefined || icon || glyph) && (
    <div class="icard-top">
      {n !== undefined && <span class="icard-n" aria-hidden="true">{String(n).padStart(2, "0")}</span>}
      {icon && <span class="icard-ico"><img src={`/art/icon-${icon}.svg`} alt="" width="30" height="30" loading="lazy" /></span>}
      {glyph && <span class="icard-ico"><Icon name={glyph} /></span>}
    </div>
  )}
  <h3 class="icard-title">{title}</h3>
  {text && <p class="icard-text">{text}</p>}
  <slot />
</Tag>

<style>
  .icard {
    display: flex; flex-direction: column; gap: 0.6rem;
    padding: clamp(1.3rem, 1.7vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--cream); color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .icard--white { background: #fff; }
  .icard--coral { background: var(--coral); color: #fff; box-shadow: none; }
  .icard--ink { background: var(--ink); color: #fff; box-shadow: none; }

  .icard-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.25rem; }
  .icard-n { font-family: var(--font-mono); font-size: clamp(1.9rem, 2.2vw, 2.6rem); font-weight: 600; line-height: 1.2; color: var(--coral); }
  .icard--coral .icard-n { color: #fff; }
  .icard-ico {
    display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; flex: none;
    background: #fff; color: var(--coral-700); box-shadow: inset 0 0 0 1px var(--line);
    margin-inline-start: auto;
  }
  .icard--ink .icard-ico { background: #fff; color: var(--coral-700); box-shadow: none; }
  .icard--coral .icard-ico { background: #fff; color: var(--coral-700); box-shadow: none; }
  .icard-ico img { width: 28px; height: 28px; }
  .icard-ico :global(.icon) { width: 28px; height: 28px; }

  .icard-title { font-size: var(--fs-h3); line-height: 1.5; }
  .icard-text { color: var(--muted); }
  .icard--coral .icard-text, .icard--ink .icard-text { color: inherit; opacity: 0.88; }
</style>

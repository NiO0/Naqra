---
import { footer, routes } from "../data/home";
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const year = new Date().getFullYear();
---
<footer class="footer" data-theme="dark">
  <div class="container ft-top">
    <a href={routes.home} class="ft-logo" aria-label="نقرة — الصفحة الرئيسية">
      <img src="/art/logo-reversed.svg" alt="" width="521" height="300" loading="lazy" />
    </a>

    <nav class="ft-menu" aria-label="روابط التذييل">
      <ol>
        {footer.menu.map((m, i) => (
          <li>
            <a href={m.href} class="ft-link" aria-current={m.href === path ? "page" : undefined}>
              <span class="ft-n">{String(i + 1).padStart(2, "0")}</span>
              <span class="ft-label">{m.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <div class="container ft-mid">
    <ul class="ft-contact">
      <li><a href={`mailto:${footer.email}`}><img src="/art/icon-mail.svg" alt="" width="24" height="24" /><span dir="ltr">{footer.email.toLowerCase()}</span></a></li>
      {footer.phone && <li><a href={`tel:${footer.phone}`}><span dir="ltr">{footer.phone}</span></a></li>}
    </ul>
    <ul class="ft-social" aria-label="حسابات التواصل الاجتماعي">
      {footer.socials.map((s) => (
        <li><a href={s.href} aria-label={s.name} class="ft-soc"><img src={`/art/icon-${s.icon}.svg`} alt="" width="22" height="22" /></a></li>
      ))}
    </ul>
  </div>

  <div class="container ft-bottom">
    <p>© {year} نقرة. جميع الحقوق محفوظة.</p>
    <ul class="ft-legal" aria-label="قانوني">
      {footer.legal.map((l) => <li><a href={l.href} aria-current={l.href === path ? "page" : undefined}>{l.label}</a></li>)}
    </ul>
    <p class="mono">{footer.platforms}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative; overflow: clip;
    background: var(--ink); color: #fff;
    padding-block: clamp(3.5rem, 4.2vw, 5rem) 2.5rem; /* 80 / 40 */
  }

  .ft-top { display: flex; align-items: flex-start; gap: 1.4rem; }
  .ft-logo { flex: none; display: block; width: clamp(11rem, 27.1vw, 32.6rem); } /* 521 */
  .ft-logo img { display: block; width: 100%; height: auto; }

  .ft-menu { flex: 1; min-width: 0; }
  .ft-menu ol { display: grid; gap: 0.625rem; }
  /* Cascadia Mono Light 32, white 70%, a hairline under each row */
  .ft-link {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
    font-family: var(--font-mono); font-weight: 300; font-size: clamp(1.25rem, 1.67vw, 2rem); line-height: 1.75;
    color: rgb(255 255 255 / 0.7);
    transition: color 0.3s;
  }
  .ft-n { direction: ltr; }
  .ft-label { transition: translate 0.45s var(--ease-out); }
  .ft-link:hover, .ft-link[aria-current="page"] { color: #fff; }
  .ft-link:hover .ft-label { translate: 0.6rem 0; }

  .ft-mid { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-top: clamp(2rem, 2.1vw, 2.6rem); }
  .ft-contact { display: flex; flex-wrap: wrap; gap: 1.6rem; }
  .ft-contact a { display: inline-flex; align-items: center; gap: 0.66rem; font-family: var(--font-mono); font-size: clamp(1rem, 0.94vw, 1.125rem); line-height: 1.5; transition: color 0.3s; }
  .ft-contact a:hover { color: var(--coral); }
  .ft-contact img { width: 24px; height: 24px; }
  .ft-social { display: flex; gap: 0.56rem; }
  .ft-soc {
    display: grid; place-items: center; width: 43px; height: 43px; border-radius: 50%;
    background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 0.9px rgb(255 255 255 / 0.14);
    transition: background-color 0.35s, transform 0.5s var(--ease-spring);
  }
  .ft-soc:hover { background: var(--coral); transform: translateY(-4px) rotate(-8deg); }
  .ft-soc img { width: 21.5px; height: 21.5px; }

  .ft-bottom {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: clamp(2rem, 2.1vw, 2.6rem); padding-top: clamp(2rem, 2.1vw, 2.6rem);
    border-top: 1px solid var(--muted);
    color: var(--muted-2); font-size: var(--fs-mono); line-height: 1.65;
  }

  .ft-legal { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; margin-inline-end: auto; }
  .ft-legal a { transition: color 0.3s; text-underline-offset: 3px; }
  .ft-legal a:hover, .ft-legal a[aria-current="page"] { color: #fff; text-decoration: underline; }

  @media (max-width: 860px) {
    .ft-top { flex-direction: column; gap: 2.5rem; }
    .ft-menu { width: 100%; }
  }
</style>

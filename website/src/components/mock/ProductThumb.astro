---
// Tiny flat product illustrations used inside the UI mock-ups.
interface Props { kind: "tshirt" | "bottle" | "bag" | "watch" | "shoe" | "mug"; class?: string }
const { kind, class: cls = "" } = Astro.props;
const bg: Record<string, string> = {
  tshirt: "#fde4dd", bottle: "#e3eef0", bag: "#f3e6d8", watch: "#ece7f4", shoe: "#e6f0e4", mug: "#f6ecd9",
};
---
<svg class:list={["pthumb", cls]} viewBox="0 0 40 40" aria-hidden="true">
  <rect width="40" height="40" rx="10" fill={bg[kind]} />
  {kind === "tshirt" && (
    <path d="M14.5 10.5l-6 3.6 2.3 5 2.9-1.3V30h12.6V17.8l2.9 1.3 2.3-5-6-3.6c-.8 1.9-2.8 3.2-5 3.2s-4.2-1.3-6-3.2z" fill="#f26e53" />
  )}
  {kind === "bottle" && (
    <g><rect x="16.5" y="7.5" width="7" height="4" rx="1.2" fill="#353535" /><path d="M15.5 12h9c1.4 0 2.5 1.1 2.5 2.5V31a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 13 31V14.5c0-1.4 1.1-2.5 2.5-2.5z" fill="#7aa7b0" /><rect x="13" y="19" width="14" height="6" fill="#fff" opacity=".55" /></g>
  )}
  {kind === "bag" && (
    <g><path d="M15 15v-2.5a5 5 0 0 1 10 0V15" fill="none" stroke="#8a5a3c" stroke-width="2" /><path d="M10.5 15h19l-1.5 16.5a2 2 0 0 1-2 1.8H14a2 2 0 0 1-2-1.8z" fill="#c08457" /></g>
  )}
  {kind === "watch" && (
    <g><rect x="15.5" y="6" width="9" height="28" rx="3" fill="#6b5a8e" /><circle cx="20" cy="20" r="7.5" fill="#fff" stroke="#353535" stroke-width="1.6" /><path d="M20 16.5V20l2.6 1.6" stroke="#f26e53" stroke-width="1.6" stroke-linecap="round" fill="none" /></g>
  )}
  {kind === "shoe" && (
    <g><path d="M8 25.5c0-3 1-7 2.5-9.5l4 1.5c1.5 2.5 4 3.8 7 4.2l6.5 1c2.5.4 4 2 4 4.3v1.5H8z" fill="#5f9a62" /><rect x="8" y="27.5" width="24" height="3.5" rx="1.5" fill="#353535" /></g>
  )}
  {kind === "mug" && (
    <g><path d="M11 13h15v13a5 5 0 0 1-5 5h-5a5 5 0 0 1-5-5z" fill="#d79a4a" /><path d="M26 16h2.5a3.5 3.5 0 0 1 0 7H26" fill="none" stroke="#d79a4a" stroke-width="2.2" /></g>
  )}
</svg>
<style>
  .pthumb { width: 100%; height: auto; }
</style>

---
import Base from "../layouts/Base.astro";
import PageHero from "../components/sections/PageHero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import Faq from "../components/sections/Faq.astro";
import SectionHead from "../components/ui/SectionHead.astro";
import CompareBoard from "../components/mock/CompareBoard.astro";
import Arrow from "../components/brand/Arrow.astro";
import Icon from "../components/ui/Icon.astro";
import { meta, hero, steps, bulk, aiProcess, finalCta, faqs } from "../data/how-it-works";
import { inAction } from "../data/home";

// Hero mini workflow: connect → select → optimize → apply
const flowIcons = ["link", "stack", "spark", "check"];
const ex = inAction.example;
---
<Base title={meta.title} description={meta.description}>
  <PageHero eyebrow={hero.eyebrow} title={hero.title} sub={hero.sub} primary={hero.primary}>
    <figure slot="visual" class="hflow" data-inview aria-label={hero.flow.join(" ← ")}>
      <ol class="hf-steps">
        {hero.flow.map((label, i) => (
          <li class="hf-step" style={`--i:${i}`}>
            <span class="hf-ico"><Icon name={flowIcons[i]} /></span>
            <span class="hf-n mono">{String(i + 1).padStart(2, "0")}</span>
            <span class="hf-label">{label}</span>
          </li>
        ))}
      </ol>
      <span class="hf-cursor" aria-hidden="true"><Arrow /></span>
    </figure>
  </PageHero>

  <HowItWorks copy={steps} id="steps" />

  <section class="section bulk" id="bulk" aria-labelledby="bulk-title">
    <div class="container bulk-grid">
      <div class="bulk-copy">
        <SectionHead eyebrow={bulk.eyebrow} id="bulk-title" sub={bulk.sub}>{bulk.headline}</SectionHead>
        <div class="bulk-stack" aria-hidden="true" data-inview>
          {[0, 1, 2, 3, 4, 5].map((n) => <i style={`--n:${n}`}><b></b><em></em></i>)}
        </div>
      </div>
      <CompareBoard rows={bulk.rows} manualLabel={bulk.manualLabel} naqraLabel={bulk.naqraLabel} class="bulk-board" />
    </div>
  </section>

  <section class="section aip" id="ai-process" data-theme="dark" aria-labelledby="aip-title">
    <div class="container">
      <SectionHead eyebrow={aiProcess.eyebrow} center id="aip-title" sub={aiProcess.sub}>{aiProcess.headline}</SectionHead>

      <ol class="aip-flow" data-inview>
        {aiProcess.stages.map((s, i) => (
          <li class:list={["aip-stage", i === 1 && "is-ai"]} style={`--i:${i}`} data-reveal="card">
            <p class="aip-latin mono">{String(i + 1).padStart(2, "0")} / {s.latin}</p>
            <h3 class="aip-title">{s.title}</h3>
            <p class="aip-text">{s.text}</p>
            <div class="aip-ui" aria-hidden="true">
              {i === 0 && (
                <div class="aip-row is-raw">
                  <img src="/art/thumb-tshirt-before.svg" alt="" width="40" height="40" />
                  <span><b>{ex.before.title}</b><small>{ex.before.desc}</small></span>
                </div>
              )}
              {i === 1 && (
                <div class="aip-think">
                  <img src="/art/how-sparkle.svg" alt="" width="22" height="22" class="aip-spark" />
                  <i style="--w:92%"></i><i style="--w:74%"></i><i style="--w:84%"></i>
                </div>
              )}
              {i === 2 && (
                <div class="aip-row is-done">
                  <img src="/art/thumb-tshirt-after.svg" alt="" width="40" height="40" loading="lazy" decoding="async" />
                  <span><b>{ex.after.title}</b><small class="aip-ok"><img src="/art/how-check-green.svg" alt="" width="14" height="14" /> SEO · Meta · Alt</small></span>
                </div>
              )}
            </div>
            {i < 2 && <span class="aip-arrow" aria-hidden="true"><Icon name="arrowStart" /></span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FinalCta copy={finalCta} />
  <Faq {...faqs} />
</Base>

<style>
  /* ---------- Hero: four connected chips, the brand cursor clicks each in turn ---------- */
  .hflow {
    position: relative; margin: 0;
    padding: clamp(1.5rem, 2.6vw, 3rem);
    border-radius: var(--radius-lg);
    background: #fff; box-shadow: inset 0 0 0 1px var(--line), 0 40px 80px -50px rgb(125 38 20 / 0.35);
  }
  .hf-steps { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.5rem, 1vw, 1rem); }
  .hf-steps::before { /* dashed connector behind the chips */
    content: ""; position: absolute; top: 2.1rem; inset-inline: 12%; height: 2px;
    background: repeating-linear-gradient(to left, var(--coral) 0 8px, transparent 8px 14px);
  }
  .hf-step { position: relative; display: grid; justify-items: center; gap: 0.4rem; text-align: center; }
  .hf-ico {
    display: grid; place-items: center; width: 4.2rem; height: 4.2rem; border-radius: 50%;
    background: var(--cream); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line-strong);
  }
  .hf-ico :global(.icon) { width: 1.9rem; height: 1.9rem; }
  .hf-n { color: var(--muted); font-size: 0.75rem; }
  .hf-label { font-family: var(--font-head); font-weight: 600; font-size: clamp(1rem, 1.3vw, 1.4rem); line-height: 1.4; }
  /* each chip lights up in turn, on a 6s loop */
  .is-inview .hf-ico { animation: hf-on 6s var(--ease-out) infinite; animation-delay: calc(var(--i) * 0.9s); }
  @keyframes hf-on {
    0%, 4% { background: var(--cream); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line-strong); transform: scale(1); }
    8% { transform: scale(0.9); }
    14%, 70% { background: var(--coral); color: #fff; box-shadow: inset 0 0 0 0 transparent, 0 0 0 8px var(--coral-100); transform: scale(1); }
    85%, 100% { background: var(--cream); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--line-strong); transform: scale(1); }
  }
  .hf-cursor { position: absolute; width: 3rem; color: var(--coral); inset-inline-start: 13%; top: 3.4rem; rotate: -12deg; }
  .is-inview .hf-cursor { animation: hf-move 6s var(--ease-out) infinite; }
  @keyframes hf-move {
    0% { inset-inline-start: 13%; }
    15% { inset-inline-start: 38%; }
    30% { inset-inline-start: 63%; }
    45%, 80% { inset-inline-start: 86%; }
    100% { inset-inline-start: 13%; }
  }
  :global(.reduced) .hf-ico { background: var(--coral); color: #fff; }

  /* ---------- Bulk optimization in action ---------- */
  .bulk { background: var(--cream); }
  .bulk-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 4.5vw, 6rem); align-items: center; }
  .bulk-copy { display: grid; gap: clamp(2rem, 3vw, 3rem); }
  .bulk-board { max-width: 40rem; width: 100%; justify-self: end; }
  /* a pile of product rows: one row, then many — same click */
  .bulk-stack { position: relative; height: 9rem; max-width: 26rem; }
  .bulk-stack i {
    position: absolute; inset-inline: 0; top: 0;
    display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem 1rem;
    border-radius: 18px; background: #fff; box-shadow: 0 12px 26px -16px rgb(120 41 20 / 0.35), inset 0 0 0 1px var(--line);
    transition: translate 0.9s var(--ease-out), rotate 0.9s var(--ease-out), opacity 0.4s;
    transition-delay: calc(var(--n) * 0.08s);
  }
  .bulk-stack i:first-child { opacity: 1; z-index: 2; }
  .bulk-stack i:not(:first-child) { opacity: 0; }
  .is-inview.bulk-stack i:not(:first-child) { opacity: 1; translate: 0 calc(var(--n) * 0.9rem); rotate: calc(var(--n) * -1.2deg); }
  .bulk-stack b { flex: 1; height: 9px; border-radius: 99px; background: linear-gradient(90deg, var(--coral), var(--coral-200)); }
  .bulk-stack em { width: 30px; height: 30px; border-radius: 9px; background: var(--coral-100); flex: none; }

  /* ---------- AI optimization process ---------- */
  .aip { background: var(--ink); color: #fff; }
  .aip :global(.lead) { max-width: 46rem; color: var(--muted-2); }
  .aip-flow {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3.5rem);
    margin-top: clamp(2.5rem, 4vw, 4.5rem);
  }
  .aip-stage {
    position: relative; display: flex; flex-direction: column; gap: 0.6rem;
    padding: clamp(1.4rem, 1.9vw, 2.25rem); border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
  }
  .aip-stage.is-ai { background: var(--coral); box-shadow: none; }
  .aip-latin { color: var(--coral); font-weight: 600; }
  .is-ai .aip-latin { color: #fff; }
  .aip-title { font-size: var(--fs-h3); line-height: 1.5; }
  .aip-text { color: var(--muted-2); }
  .is-ai .aip-text { color: #fff; opacity: 0.9; }
  .aip-ui { margin-top: auto; padding-top: 1rem; }
  .aip-row { display: grid; grid-template-columns: 40px 1fr; gap: 0.75rem; align-items: center; padding: 0.75rem; border-radius: 16px; background: #fff; color: var(--ink); }
  .aip-row > img { width: 40px; height: 40px; border-radius: 10px; }
  .aip-row span { display: grid; min-width: 0; }
  .aip-row b { font-weight: 600; font-size: 0.9rem; line-height: 1.5; }
  .aip-row small { font-size: 0.75rem; color: var(--muted); }
  .is-raw { background: var(--sand); }
  .is-raw b { color: var(--muted); }
  .aip-ok { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--ok) !important; font-family: var(--font-mono); direction: ltr; justify-content: flex-end; }
  .aip-think { display: grid; gap: 0.5rem; padding: 0.9rem; border-radius: 16px; background: rgb(255 255 255 / 0.2); }
  .aip-spark { width: 22px; height: 22px; filter: brightness(0) invert(1); }
  .aip-think i {
    display: block; height: 9px; width: var(--w); border-radius: 99px;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.35) 0%, #fff 50%, rgb(255 255 255 / 0.35) 100%);
    background-size: 300% 100%; background-position: 100% 0;
  }
  .is-inview .aip-think i { animation: aip-shimmer 1.6s linear infinite; }
  .is-inview .aip-spark { animation: aip-spin 2.4s linear infinite; }
  @keyframes aip-shimmer { to { background-position: -50% 0; } }
  @keyframes aip-spin { to { rotate: 360deg; } }
  .aip-arrow {
    position: absolute; z-index: 1; top: 50%; inset-inline-end: calc(-1 * clamp(1.5rem, 3vw, 3.5rem) / 2 - 1.2rem);
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; margin-top: -1.2rem;
    border-radius: 50%; background: #fff; color: var(--coral-700);
  }
  .aip-arrow :global(.icon) { width: 1.4rem; height: 1.4rem; }

  @media (max-width: 1000px) {
    .bulk-grid { grid-template-columns: minmax(0, 1fr); }
    .bulk-board { justify-self: stretch; max-width: none; }
    .aip-flow { grid-template-columns: minmax(0, 1fr); max-width: 34rem; margin-inline: auto; }
    .aip-arrow { top: auto; bottom: calc(-1 * clamp(1.5rem, 3vw, 3.5rem) / 2 - 1.2rem); inset-inline-end: 50%; margin: 0 -1.2rem 0 0; rotate: -90deg; }
  }
  @media (max-width: 560px) {
    .hf-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.5rem; }
    .hf-steps::before, .hf-cursor { display: none; }
    .bulk-stack { height: 8rem; }
  }
</style>
